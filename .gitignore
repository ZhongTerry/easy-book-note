# === 1. 敏感信息与本地配置 ===
.env
auth_key.json
user_token.json
fanqie_session.json
config.env

# === 2. 用户数据与数据库 (核心保护) ===
user_data*
backups/
*.db
*.sqlite
# 忽略 SQLite 的临时日志文件 (写前日志/共享内存)
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# === 3. 缓存与运行临时文件 ===
/cache/
/library/
/downloads/
/debug/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.buffer
stats.json

# === 4. Python 虚拟环境 ===
venv/
.venv/
env/
ENV/

# === 5. Electron / Node.js 相关 (app_shell 目录) ===
app_shell/node_modules/
app_shell/dist/
app_shell/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# === 6. 打包产物 (PyInstaller & Electron Builder) ===
dist/
build/
*.spec

# === 7. 系统与 IDE / 工具脚本 ===
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
/tools
debug.*
*.log
